# Node Environment & Server Port
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Supabase connection string with pooled / direct options)
DATABASE_URL=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Brevo Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@abyssinia.et
BREVO_SENDER_NAME=Bank of Abyssinia Performance Management

# Cloudinary Profile Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
