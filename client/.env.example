# Copy to `.env.local` and adjust. Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets in frontend environment files.

# Base URL of the Express REST API (see docs/IMPLEMENTATION_PLAN.md §8)
VITE_API_BASE_URL=http://localhost:4000/api

# true  → use in-browser mock adapters (src/services/mock) for frontend development
# false → use real HTTP adapters against VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Display name used in the UI
VITE_APP_NAME=Staff Performance
